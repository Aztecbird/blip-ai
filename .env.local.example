# Frontend origin used by local backends
BLIP_FRONTEND_ORIGIN=http://localhost:5173
BLIP_ALLOWED_ORIGINS=http://localhost:5173,https://www.blipai.es

# Toggle local services on/off for the one-command dev stack
BLIP_ENABLE_KOKORO=1
BLIP_ENABLE_CALENDAR_BACKEND=1
BLIP_ENABLE_GMAIL_BACKEND=1
# Leave blank to auto-start Telegram when TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are set.
BLIP_ENABLE_TELEGRAM_BACKEND=
BLIP_ENABLE_MEDIA_BACKEND=1
BLIP_ENABLE_OPENAI_IMAGE_BACKEND=0
BLIP_ENABLE_WEATHER_BACKEND=1
# Blank = start Hume backend (recommended: fixes /api/hume health + Vite proxy). Use 0 to skip.
BLIP_ENABLE_HUME_BACKEND=

# Experimental Hume companion mode
HUME_COMPANION_ENABLED=false
HUME_API_KEY=
HUME_SECRET_KEY=
# Optional: EVI configuration id from the Hume dashboard
HUME_CONFIG_ID=
HUME_BACKEND_PORT=8796
# Optional override if Hume changes the websocket URL for your account/version
HUME_WEBSOCKET_URL=wss://api.hume.ai/v0/evi/chat

# Weather backend (OpenWeatherMap)
WEATHER_API_KEY=
WEATHER_BACKEND_PORT=8792

# Google Calendar backend
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8787/api/google-calendar/auth/callback
GOOGLE_CALENDAR_BACKEND_PORT=8787

# Gmail backend
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://127.0.0.1:8788/api/gmail/auth/callback
GOOGLE_GMAIL_BACKEND_PORT=8788

# Telegram backend
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: comma-separated aliases, e.g. joy:8651008577 or joy:-1001234567890
TELEGRAM_CHAT_ALIASES=
# Optional: when the app leaves chat id blank, resolve this alias first (e.g. joy) before TELEGRAM_CHAT_ID
TELEGRAM_DEFAULT_ALIAS=
TELEGRAM_BACKEND_PORT=8789

# Local media actions backend
MEDIA_ACTIONS_BACKEND_PORT=8791

# Optional OpenAI image backend
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_BACKEND_PORT=8790

# Kokoro local TTS
KOKORO_HOST=127.0.0.1
KOKORO_PORT=8765

# Google Gemini API (for backend proxy)
GOOGLE_GEMINI_API_KEY=
GEMINI_BACKEND_PORT=8793
