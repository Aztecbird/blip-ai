{
    "name": "blip-ai",
    "private": true,
    "version": "4.3.25",
    "type": "module",
    "scripts": {
        "dev": "bash ./start-dev.sh",
        "dev:web": "vite",
        "dev:stack": "bash ./start-dev.sh",
        "dev:fresh": "BLIP_FORCE_FRONTEND_RESTART=1 bash ./start-dev.sh",
        "stack:start": "bash ./blip-stack.sh start",
        "stack:stop": "bash ./blip-stack.sh stop",
        "stack:restart": "bash ./blip-stack.sh restart",
        "stack:status": "bash ./blip-stack.sh status",
        "stack:logs": "bash ./blip-stack.sh logs",
        "dev:calendar-backend": "node server/googleCalendarBackend.js",
        "dev:gmail-backend": "node server/googleGmailBackend.js",
        "dev:telegram-backend": "node server/telegramBackend.js",
        "dev:media-backend": "node server/mediaActionsBackend.js",
        "dev:care-cam-backend": "node server/careCamBackend.js",
        "dev:hub-backend": "node server/hubBackend.js",
        "dev:hume-backend": "node server/humeBackend.js",
        "dev:expense-tracker-backend": "node server/expenseTrackerBackend.js",
        "dev:openai-image-backend": "node server/openaiImageBackend.js",
        "dev:weather-backend": "node server/weatherBackend.js",
        "dev:gemini-backend": "node server/geminiBackend.js",
        "build": "vite build",
        "test": "node --test tests/*.test.js",
        "preview": "vite preview"
    },
    "devDependencies": {
        "vite": "^5.0.0"
    },
    "dependencies": {
        "@arcadeai/arcadejs": "^2.3.0",
        "dotenv": "^17.4.0"
    }
}
